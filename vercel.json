{
  "redirects": [
    {
      "source": "/contact",
      "destination": "/#sign-up",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/calls",
      "schedule": "0 6 * * *"
    }
  ]
}
